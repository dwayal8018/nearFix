# ---- Database ----
# Local dev (PostgreSQL running on your machine):
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nearfix?schema=public"
# Production (Supabase): copy the connection string from Supabase > Project Settings > Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nearfix?schema=public"

# ---- Auth.js ----
# Generate a secret with:  npx auth secret   (or any long random string)
AUTH_SECRET="change-me-to-a-long-random-string"
# Base URL of the app (dev default below)
NEXTAUTH_URL="http://localhost:3000"

# ---- Seed admin account (created by prisma/seed.ts) ----
SEED_ADMIN_NAME="NearFix Admin"
SEED_ADMIN_PHONE="9999999999"
SEED_ADMIN_PASSWORD="change-this-admin-password"

# ---- File storage ----
# "local" stores uploads in /public/uploads (dev). Switch to "supabase" for production.
STORAGE_DRIVER="local"
# Only needed when STORAGE_DRIVER="supabase":
# SUPABASE_URL=""
# SUPABASE_SERVICE_ROLE_KEY=""
# SUPABASE_STORAGE_BUCKET="nearfix-photos"
